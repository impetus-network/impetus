# Project admin (sudo) — single mnemonic shared across all services.
# Account #0 of this mnemonic is the sudo / admin address on the Artemis chain
# and is pre-funded with 1,000,000 ART at genesis.
#
# Now managed via Infisical. Run: infisical login && infisical init
# Or regenerate for non-test deployment: cast wallet new-mnemonic --words 24 --accounts 1
ADMIN_MNEMONIC=
ADMIN_ADDRESS=
ADMIN_PRIVATE_KEY=

# UI (apps/ui)
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=
# Subsquid GraphQL (graphql-server / OpenReader). Single indexer for the chain.
NEXT_PUBLIC_SQUID_URL=http://localhost:4350

# ENS resolution (server-side only — not exposed to browser)
ETH_MAINNET_RPC_URL=
