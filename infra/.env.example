# =============================================================================
# Project admin (sudo) — single mnemonic shared across all services.
# Account #0 is sudo / admin and is pre-funded at genesis.
#
# LEAVE BLANK in version control. Each operator generates their own:
#   cast wallet new-mnemonic --words 24 --accounts 1
# NEVER commit a populated value — anyone with the mnemonic owns sudo.
# (The previous committed dev values are permanently compromised; do not reuse.)
# =============================================================================
ADMIN_MNEMONIC=
ADMIN_ADDRESS=
ADMIN_PRIVATE_KEY=

# =============================================================================
# OZ Relayer signing keys — separate hot-wallet identities so a relayer
# compromise never gives away the sudo key.
#
# LEAVE BLANK in version control. Generate via `cast wallet new-mnemonic --words
# 24 --accounts 1` (twice) and run infra/oz-relayer/scripts/encrypt-keys.mjs to
# create the v3 keystores at infra/oz-relayer/keys/. Never commit populated keys.
# =============================================================================
BASE_RELAYER_MNEMONIC=
BASE_RELAYER_ADDRESS=
BASE_RELAYER_KEY=

ARTEMIS_RELAYER_MNEMONIC=
ARTEMIS_RELAYER_ADDRESS=
ARTEMIS_RELAYER_KEY=

# =============================================================================
# OZ Relayer keystore passphrase (used to decrypt config/keys/*.json v3 keystores).
# Same passphrase MUST be used when running infra/oz-relayer/scripts/encrypt-keys.mjs
# to (re)generate the keystore files. Set per-deployment; never commit.
# =============================================================================
KEYSTORE_PASSPHRASE=

# =============================================================================
# OZ Relayer HTTP API
# Generate API_KEY with: uuidgen   (any UUID works; relayer treats it as a bearer)
# Trigger scripts inside oz-monitor read RELAYER_API_KEY (same value) to call
# the relayer's /sign and /transactions endpoints.
# =============================================================================
API_KEY=
RELAYER_API_KEY=

# =============================================================================
# RPC endpoints
# =============================================================================
ARTEMIS_RPC_URL=http://host.docker.internal:9944
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# =============================================================================
# Deployed contract addresses — fill in after running the deploy scripts.
# These are referenced by oz-monitor configs (artemis_result_requested.json,
# base_result_fulfilled.json) and the relay trigger scripts.
# =============================================================================
CROSS_CHAIN_RECEIVER_ADDRESS=
VRF_RESULT_SOURCE_ADDRESS=

# =============================================================================
# Chainlink VRF (Base Sepolia) — needed for ChainlinkVRFResultSource deploy.
# =============================================================================
VRF_COORDINATOR_ADDRESS=
VRF_KEY_HASH=
VRF_SUBSCRIPTION_ID=

# =============================================================================
# Deployer key for Base Sepolia (one-shot, for `pnpm hardhat run deploy-vrf-source`).
# =============================================================================
BASE_DEPLOYER_KEY=

# =============================================================================
# Trusted relayer address that the on-chain SingleRelayerVerifier accepts as
# the proof signer. MUST equal the artemis_signer keystore's address (i.e.
# ARTEMIS_RELAYER_ADDRESS above).
# =============================================================================
TRUSTED_RELAYER_ADDRESS=

# =============================================================================
# Redis (oz-relayer state). Override only if running redis outside compose.
# =============================================================================
REDIS_URL=redis://redis:6379
