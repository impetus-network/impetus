# Common config — identical on every NODE service (validator-*, archive, rpc-singapore).
# Per-service files (<service>.env) carry only the deltas on top of this.

# Chain spec: baked into the image at /opt/impetus.json (v0.3.0). CHAIN_SPEC_URL
# is only a cold-start fallback if the baked file is ever absent.
CHAIN_SPEC_PATH=/opt/impetus.json
CHAIN_SPEC_URL=https://gist.githubusercontent.com/DuanTranHuy/00b6aa95104f9af20212f4f4ec8b7ce2/raw/impetus.json

# Required: Railway volumes mount root-owned but the image runs as uid 10000.
# Without this the spec fetch/keystore writes fail and the container crash-loops.
RAILWAY_RUN_UID=0

# FULL-MESH bootnodes — every node listed so each dials every other directly.
# Fewer bootnodes -> star topology (2 peers each) on Railway private networking.
BOOTNODES=/dns4/validator-1.railway.internal/tcp/30333/p2p/12D3KooWPH4Dp9n9csjEgWy3MWsnrRfEy1ewCYkahG59uNt5S3q9 /dns4/validator-2.railway.internal/tcp/30333/p2p/12D3KooWDLzWZxgqwtab7mH2YLb7NWEgpNdkumHmJRySnmEgBjEL /dns4/validator-3.railway.internal/tcp/30333/p2p/12D3KooWATCQCifMZqrAabzLsSa5YQEWPDRw3fVpCukKvPR1swZB /dns4/validator-4.railway.internal/tcp/30333/p2p/12D3KooWBnkAs9C9XPkpGARqxQRC2xsbpo8bT8oG6cMsnM4W8dz6 /dns4/validator-5.railway.internal/tcp/30333/p2p/12D3KooWSezFEk7GEDba2rdMDCciGFuFZjwrPFT9HwsxVNzhfHys /dns4/archive.railway.internal/tcp/30333/p2p/12D3KooWQMFKDsV7Uzq9e2jQs7R47MoZEdbrgAU1rDVDNy474ssM

# Low-RAM caps (bind once the DB grows; harmless on a young chain).
DB_CACHE=128
TRIE_CACHE_SIZE=16777216
