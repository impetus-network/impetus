# rpc-singapore — region: southeast-asia · service id bbc771db-64fa-4269-9d4e-a3924a6e753f · volume rpc-singapore-volume
# Pruned full node serving external RPC behind the rpc-proxy (Caddy) allow-list.
# STATE_PRUNING unset -> entrypoint rpc-role default (256). Inherits _common.env.
# Secret (off-tree, gitignored):
#   NODE_KEY_HEX -> apps/node/launch-keys/node-keys/node-7.key
ROLE=rpc
NODE_NAME=rpc-singapore
MAX_RUNTIME_INSTANCES=4
BLOCKS_PRUNING=256
