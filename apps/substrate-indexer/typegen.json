{
  "outDir": "src/types",
  "//": "specVersions points at the metadata history produced by `npm run metadata` (squid-substrate-metadata-explorer against RPC_ENDPOINT). Regenerate it whenever the runtime spec_version changes.",
  "specVersions": "versions.jsonl",
  "pallets": {
    "Staking": {
      "events": [
        "Bonded",
        "Unbonded",
        "Withdrawn",
        "ValidatorPrefsSet",
        "Chilled",
        "Kicked",
        "PayoutStarted",
        "Rewarded",
        "Slashed",
        "StakersElected",
        "EraPaid"
      ],
      "calls": ["nominate"],
      "storage": ["ErasValidatorReward", "Ledger", "Validators"]
    },
    "NominationPools": {
      "events": [
        "Created",
        "Bonded",
        "PaidOut",
        "Unbonded",
        "Withdrawn",
        "StateChanged",
        "MemberRemoved",
        "PoolCommissionUpdated"
      ]
    },
    "Session": {
      "storage": ["Validators"]
    },
    "System": {
      "storage": ["Account"]
    },
    "Balances": {
      "events": [
        "Transfer",
        "Endowed",
        "Deposit",
        "Withdraw",
        "Reserved",
        "Unreserved",
        "Slashed",
        "BalanceSet",
        "Minted",
        "Burned"
      ],
      "storage": ["TotalIssuance"]
    },
    "GaslessRegistry": {
      "events": ["RuleSet", "RuleRemoved"]
    }
  }
}
