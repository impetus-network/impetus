# Substrate RPC of the Impetus ARCHIVE node (full history). The node's native
# JSON-RPC (state_* / chain_*) — NOT the eth rpc-proxy (eth-only + Origin-gated)
# and NOT the pruned rpc-singapore node (can't serve old blocks).
#
# On Railway, run this squid as a service in the SAME project and use private
# networking (the archive runs --rpc-external --pruning archive, methods=safe):
RPC_ENDPOINT=http://archive.railway.internal:9944
# Off-Railway (laptop / external indexer): the archive's Railway TCP proxy, e.g.
#   RPC_ENDPOINT=http://<name>.proxy.rlwy.net:<port>
# (public + no rate-limit — front with Caddy or remove the proxy when done).
# Local against a port-forwarded / tunneled archive: http://127.0.0.1:9944

# Postgres for the TypeormStore + GraphQL server.
DB_NAME=impetus_squid
DB_PORT=5432
DB_HOST=localhost
DB_USER=postgres
DB_PASS=postgres

# GraphQL server (OpenReader) port; the dApp reads this as NEXT_PUBLIC_SQUID_URL.
GQL_PORT=4350
